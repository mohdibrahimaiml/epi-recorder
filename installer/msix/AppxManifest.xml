<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build of EPI Recorder.

  scripts/build_msix.ps1 fills the @...@ placeholders:
    @IDENTITY_NAME@           Package/Identity/Name from Partner Center (Product identity)
    @PUBLISHER@               Package/Identity/Publisher from Partner Center ("CN=...")
    @PUBLISHER_DISPLAY_NAME@  Publisher display name from Partner Center
    @VERSION@                 X.Y.Z.0 (the Store requires the last part to be 0)

  The Store signs the package when it is published, so the .msix built here is
  submitted unsigned. Two applications share one package:
    - EPIViewer: the Start menu entry; opens the viewer (`epi view`).
    - EPICLI:    no Start entry; provides the `epi` command in a terminal and
                 opens .epi files with `epi view "<file>"`.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 uap10 desktop rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>EPI Recorder</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Open and check sealed AI decision records (.epi files) offline.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="EPIViewer"
      Executable="epi\epi.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:Parameters="view">
      <uap:VisualElements
        DisplayName="EPI Recorder"
        Description="Open and check sealed AI decision records (.epi files) offline."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>

    <Application
      Id="EPICLI"
      Executable="epi\epi.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="EPI Recorder command line"
        Description="The epi command for terminals and scripts."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap3:Extension
          Category="windows.appExecutionAlias"
          Executable="epi\epi.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="epi.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="epirecording">
            <uap:DisplayName>EPI Recording File</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.epi</uap:FileType>
            </uap:SupportedFileTypes>
            <uap2:SupportedVerbs>
              <uap3:Verb Id="open" Parameters="view &quot;%1&quot;">Open with EPI Viewer</uap3:Verb>
            </uap2:SupportedVerbs>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
