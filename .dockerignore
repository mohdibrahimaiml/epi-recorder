# Keep secrets, history and scratch output out of the build context.
#
# The Dockerfile COPYs explicit paths, so nothing here changes what lands in the
# image — this only stops the daemon from uploading the whole working tree
# (including .env and .git) on every build.
.env
.env.*
!.env.example

.git
.github
.dockerignore

node_modules
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.coverage
htmlcov
.venv
.venv-*
.venv*/

site
website
website-v2
dist
build
*.egg-info

# Local output, recordings and scratch workspaces
.epi
.epi-*/
epi-recordings/
data/
audit_dir/
audit_sandbox/
demo_*/
scratch*/
*.epi
.tmp-*

# The audit document lists the app's weaknesses.
AUDIT.md
